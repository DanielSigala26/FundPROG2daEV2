    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="edad" type="Integer" array="False" size=""/>
            <output expression="&quot;Cual es tu edad?&quot;" newline="True"/>
            <input variable="edad"/>
            <if expression="edad &gt;= 18">
                <then>
                    <output expression="&quot;Puedes bro felicidades&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;No puedes bro perdon&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
